# ─────────────────────────────────────────────────────────────────────────────
# Medical App — Production Environment Variables
# Copy this file to: deploy/.env   (NEVER commit .env to git)
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker image registry ────────────────────────────────────────────────────
# GitHub Container Registry — ghcr.io/<your-github-org-or-username>/medical-app
IMAGE_BASE=ghcr.io/YOUR_GITHUB_USERNAME/medical-app
IMAGE_TAG=latest

# GHCR credentials (used by deploy script to pull images on the server)
GHCR_USER=YOUR_GITHUB_USERNAME
GHCR_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXX   # GitHub PAT with read:packages scope

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_STRONG_64_CHAR_SECRET_MINIMUM

# Generate with: openssl rand -base64 32
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# RabbitMQ
MQ_USER=medapp
MQ_PASSWORD=REPLACE_WITH_STRONG_MQ_PASSWORD

# Redis
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# ── External API keys ────────────────────────────────────────────────────────
CLAUDE_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXX
GOOGLE_VISION_API_KEY=XXXXXXXXXXXXXXXXXXXX
